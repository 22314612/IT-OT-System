@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">➕ Yeni Personel Kaydı</h1>
        <p class="text-muted small mb-0">Sisteme yeni bir kullanıcı veya birim yöneticisi tanımlayın.</p>
    </div>
    <a href="/User/Index" class="btn btn-outline-secondary btn-sm px-3 fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i> Personel Listesine Dön
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4">

            @if (ViewBag.Mesaj != null)
            {
                <div class="alert alert-success border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="fa-solid fa-circle-check fs-5"></i>
                    <div>@ViewBag.Mesaj</div>
                </div>
            }

            <form asp-controller="User" asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Ad Soyad</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                        <input type="text" name="fullname" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">E-posta Adresi</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input type="email" name="email" class="form-control" placeholder="ornek@sirket.com" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Geçici Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Departman Seçimi</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-building text-muted"></i></span>
                        <select name="departmentId" class="form-select" required>
                            <option value="">-- Departman Seçin --</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary">Kullanıcı Rolü</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-shield-halved text-muted"></i></span>
                        <select name="role" class="form-select" required>
                            <option value="User">Normal Personel (User)</option>
                            <option value="Supervisor">Birim Yöneticisi (Supervisor)</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 fw-semibold py-2">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Personeli Kaydet
                </button>

            </form>
        </div>
    </div>
</div>