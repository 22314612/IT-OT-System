@model IEnumerable<deneme10.Models.User>
@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div class="d-flex justify-content-between align-items: center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">👥 @(User.IsInRole("Admin") ? "Sistem Genel Personel Listesi" : "Departman Personel Listesi")</h1>
        <p class="text-muted small mb-0">Kurumsal kullanıcı hesapları, yetkiler ve departman atamaları.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-controller="User" asp-action="Index" method="get" class="d-flex">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" placeholder="İsim veya E-posta ara..." class="form-control form-control-sm rounded-start rounded-0 border-end-0" />
            <button type="submit" class="btn btn-outline-primary btn-sm rounded-end rounded-0"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        <a href="/User/Create" class="btn btn-success btn-sm fw-semibold px-3">
            <i class="fa-solid fa-user-plus me-1"></i> Yeni Personel
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="ps-4">Ad Soyad</th>
                        <th>E-Posta Adresi</th>
                        <th>Departman</th>
                        <th>Rol</th>
                        <th class="text-end pe-4">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        var currentEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@user.Fullname</td>
                                <td class="text-muted">@user.Email</td>
                                <td><span class="badge bg-light text-dark border">@(user.Department != null ? user.Department.DepartmentName : "-")</span></td>
                                <td><span class="badge bg-primary-subtle text-primary">@user.Role</span></td>
                                <td class="text-end pe-4">
                                    @if (user.Email == currentEmail)
                                    {
                                        <span class="text-muted fs-8 fst-italic">(Mevcut Hesabınız)</span>
                                    }
                                    else if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis fs-8 fw-bold">🛡️ Sistem Yöneticisi</span>
                                    }
                                    else
                                    {
                                        <form asp-controller="User" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu personeli silmek istediğinize emin misiniz?');">
                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash me-1"></i> Sil</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>