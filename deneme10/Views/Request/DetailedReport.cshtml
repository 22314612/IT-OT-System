@model IEnumerable<deneme10.Models.Record>
@{
    ViewData["Title"] = "Personel Performans ve Analiz Raporu";
    Layout = null;
    var personelRaporu = ViewBag.PersonelRaporu as IEnumerable<dynamic>;
    int toplamTalep = ViewBag.TotalCount ?? 0;
    int cozulenTalep = ViewBag.SolvedCount ?? 0;
    int incelenenTalep = ViewBag.PendingCount ?? 0;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Performans ve Analiz Raporu - IT Portal</title>
    <!-- PDF KÜTÜPHANESİ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- CHART.JS KÜTÜPHANESİ -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', sans-serif;
        }

        body {
        background: #f8fafc;
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        color: #1e293b;
        }

        .top-bar {
        width: 100%;
        max-width: 1000px;
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
        }

        .btn-back {
        background: #475569;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
        }

        .btn-back:hover {
        background: #334155;
        }

        .btn-download {
        background: #0f172a;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
        }

        .btn-download:hover {
        background: #1e293b;
        }

        .report-page {
        background: white;
        padding: 40px;
        width: 100%;
        max-width: 1000px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        }

        .report-header {
        text-align: center;
        border-bottom: 2px solid #0f172a;
        padding-bottom: 20px;
        margin-bottom: 30px;
        }

        .report-header h1 {
        color: #0f172a;
        font-size: 22px;
        font-weight: 700;
        }

        .report-header p {
        color: #64748b;
        margin-top: 5px;
        font-size: 13px;
        }

        .summary-box {
        display: flex;
        justify-content: space-around;
        background: #f8fafc;
        padding: 20px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        margin-bottom: 30px;
        }

        .summary-item {
        text-align: center;
        }

        .summary-item h3 {
        font-size: 12px;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        }

        .summary-item h2 {
        font-size: 22px;
        color: #0f172a;
        font-weight: 700;
        margin-top: 4px;
        }

        /* 🌟 GRAFİK (CHART) IZGARASI */
        .chart-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
        page-break-inside: avoid;
        }

        .chart-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        }

        .chart-title {
        font-size: 13px;
        color: #0f172a;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 15px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 10px;
        }

        .chart-wrapper {
        position: relative;
        width: 100%;
        height: 250px;
        display: flex;
        justify-content: center;
        }

        /* TABLOLAR VE DİĞER STİLLER */
        .ratio-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        page-break-inside: avoid;
        }

        .ratio-table th, .ratio-table td {
        padding: 12px 15px;
        border: 1px solid #cbd5e1;
        text-align: left;
        font-size: 13px;
        }

        .ratio-table th {
        background: #f1f5f9;
        color: #0f172a;
        text-transform: uppercase;
        font-weight: 700;
        }

        .person-section {
        page-break-before: always;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 3px solid #0f172a;
        }

        .person-title {
        background: #0f172a;
        color: white;
        padding: 12px 18px;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        }

        .record-card {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 15px;
        background: #f8fafc;
        page-break-inside: avoid;
        }

        .record-card .header {
        display: flex;
        justify-content: space-between;
        font-weight: 700;
        font-size: 14px;
        color: #0f172a;
        margin-bottom: 8px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 8px;
        }

        .record-card p {
        font-size: 13px;
        color: #334155;
        line-height: 1.5;
        margin-bottom: 6px;
        }

        .timestamp {
        text-align: right;
        font-size: 11px;
        color: #94a3b8;
        margin-top: 30px;
        border-top: 1px solid #e2e8f0;
        padding-top: 15px;
        }
    </style>
</head>
<body>

    <div class="top-bar" data-html2canvas-ignore="true">
        <a href="/Request/Index" class="btn-back">⬅ Geri Dön</a>
        <button onclick="downloadDetailedPDF()" class="btn-download">⬇️ Analiz Raporunu PDF İndir</button>
    </div>

    <div class="report-page" id="pdf-content">
        <div class="report-header">
            <h1>@ViewBag.ReportTitle</h1>
            <p>Birim içi personel bazlı iş yükü, karşılama istatistikleri ve görsel analiz dökümü.</p>
        </div>

        <div class="summary-box">
            <div class="summary-item">
                <h3>Toplam Talep</h3>
                <h2>@ViewBag.TotalCount</h2>
            </div>
            <div class="summary-item">
                <h3>Çözülen</h3>
                <h2 style="color:#10b981;">@ViewBag.SolvedCount</h2>
            </div>
            <div class="summary-item">
                <h3>İnceleniyor</h3>
                <h2 style="color:#d97706;">@ViewBag.PendingCount</h2>
            </div>
        </div>

        <!-- 🌟 DETAYLI GRAFİK ALANI -->
        <div class="chart-grid">
            <!-- 1. Durum Dağılımı (Pasta) -->
            <div class="chart-card">
                <div class="chart-title">🍕 Genel Durum Dağılımı</div>
                <div class="chart-wrapper">
                    <canvas id="statusPieChart"></canvas>
                </div>
            </div>

            <!-- 2. Aciliyet Seviyesi (Halka) -->
            <div class="chart-card">
                <div class="chart-title">🚨 Aciliyet Seviyesi Dağılımı</div>
                <div class="chart-wrapper">
                    <canvas id="urgencyDoughnutChart"></canvas>
                </div>
            </div>

            <!-- 3. Personel Karşılaştırması (Çubuk) -->
            <div class="chart-card" style="grid-column: span 2;">
                <div class="chart-title">📊 Personel İş Yükü Karşılaştırması</div>
                <div class="chart-wrapper" style="height: 280px;">
                    <canvas id="personnelBarChart"></canvas>
                </div>
            </div>
        </div>

        <!-- DETAYLI ORAN / ORANTI TABLOSU -->
        <h3 style="font-size: 14px; color: #0f172a; margin-bottom: 12px; text-transform: uppercase; font-weight: 700;">📋 Personel İş Yükü ve Oran Tablosu</h3>
        <table class="ratio-table">
            <thead>
                <tr>
                    <th>Atanan Personel</th>
                    <th>Karşılanan Talep Sayısı</th>
                    <th>Departman İçindeki Yük Oranı (%)</th>
                </tr>
            </thead>
            <tbody>
                @if (personelRaporu != null)
                {
                    foreach (var p in personelRaporu)
                    {
                        <tr>
                            <td style="font-weight: 600;">🧑‍💻 @p.PersonelAdi</td>
                            <td>@p.KarsilananSayisi Talep</td>
                            <td><strong>%@p.Oran.ToString("N1")</strong></td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="timestamp">
            Rapor Oluşturulma Zamanı: @DateTime.Now.ToString("dd.MM.yyyy HH:mm") • IT Portal Enterprise Reporting System
        </div>

        <!-- PERSONEL DETAY SAYFALARI -->
        @if (personelRaporu != null)
        {
            foreach (var p in personelRaporu)
            {
                <div class="person-section">
                    <div class="person-title">
                        <span>🧑‍💻 Personel Detay Raporu: @p.PersonelAdi</span>
                        <span style="font-size: 13px; font-weight: normal;">Karşılanan: @p.KarsilananSayisi Talep (%@p.Oran.ToString("N1"))</span>
                    </div>

                    @if (p.Talepler != null && p.Talepler.Count > 0)
                    {
                        foreach (var item in p.Talepler)
                        {
                            string statColor = item.Status == "Çözüldü" ? "#10b981" : (item.Status == "Reddedildi" ? "#ef4444" : "#d97706");
                            <div class="record-card">
                                <div class="header">
                                    <span>#@item.RecordId - @item.Title</span>
                                    <span style="font-size: 12px; color: #64748b;">Açılış: @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                                <p>
                                    <strong style="color: @statColor">Durum: @item.Status</strong> &nbsp;|&nbsp;
                                    <strong>Sahibi:</strong> @(item.User?.Fullname ?? "Bilinmiyor") &nbsp;|&nbsp;
                                    <strong>Öncelik:</strong> @item.Urgency &nbsp;|&nbsp;
                                    <strong>Tür:</strong> @item.RecordType
                                </p>
                                <p style="margin-top: 6px;"><strong>Açıklama:</strong> @item.Content</p>
                                <p style="margin-top: 6px; color: #0f172a; background: #fff; padding: 8px; border-radius: 4px; border: 1px dashed #cbd5e1;">
                                    <strong>İşlem Notu / Yanıt:</strong> @(string.IsNullOrEmpty(item.FeedbackText) || item.FeedbackText == "İnceleniyor..." ? "Henüz işlem notu girilmedi." : item.FeedbackText)
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 20px; text-align: center; color: #64748b; font-style: italic; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px;">
                            Bu personel üzerine atanmış talep bulunmamaktadır.
                        </div>
                    }
                </div>
            }
        }
    </div>

    <script>
        // PDF dışa aktarma (Animasyonlar bitince düzgün çıkması için ayarlı)
        function downloadDetailedPDF() {
        const element = document.getElementById('pdf-content');
        const opt = {
        margin:       0.4,
        filename:     'Detayli_Analiz_Raporu.pdf',
        image:        { type: 'jpeg', quality: 1 },
        html2canvas:  { scale: 2, useCORS: true },
        jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
        };
        html2pdf().set(opt).from(element).save();
        }

        document.addEventListener("DOMContentLoaded", function () {
        // PDF'e çevirirken canvas boş çıkmasın diye animasyonları kapatıyoruz
        Chart.defaults.animation = false;
        Chart.defaults.font.family = "'Segoe UI', sans-serif";

        // --- Veri Hazırlığı ---
        const cozulduCount = @(Model?.Count(x => x.Status == "Çözüldü") ?? 0);
        const inceleniyorCount = @(Model?.Count(x => x.Status == "İnceleniyor" || x.Status == "Beklemede") ?? 0);
        const reddedildiCount = @(Model?.Count(x => x.Status == "Reddedildi") ?? 0);

        const acilCount = @(Model?.Count(x => x.Urgency == "Acil") ?? 0);
        const ortaCount = @(Model?.Count(x => x.Urgency == "Orta") ?? 0);
        const dusukCount = @(Model?.Count(x => x.Urgency == "Düşük") ?? 0);

        const pNames = [];
        const pCounts = [];
        @if (personelRaporu != null)
        {
            foreach (var p in personelRaporu)
            {
                <text>
                    pNames.push('@p.PersonelAdi');
                    pCounts.push(@p.KarsilananSayisi);
                </text>
            }
        }

        // 1. DURUM DAĞILIMI (PASTA GRAFİĞİ)
        new Chart(document.getElementById('statusPieChart').getContext('2d'), {
        type: 'pie',
        data: {
        labels: ['Çözüldü', 'İnceleniyor', 'Reddedildi'],
        datasets: [{
        data: [cozulduCount, inceleniyorCount, reddedildiCount],
        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
        borderWidth: 1
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
        }
        });

        // 2. ACİLİYET (HALKA GRAFİĞİ)
        new Chart(document.getElementById('urgencyDoughnutChart').getContext('2d'), {
        type: 'doughnut',
        data: {
        labels: ['Acil', 'Orta', 'Düşük'],
        datasets: [{
        data: [acilCount, ortaCount, dusukCount],
        backgroundColor: ['#dc2626', '#f59e0b', '#3b82f6'],
        borderWidth: 1
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } },
        cutout: '60%'
        }
        });

        // 3. PERSONEL YÜKÜ (ÇUBUK GRAFİK)
        new Chart(document.getElementById('personnelBarChart').getContext('2d'), {
        type: 'bar',
        data: {
        labels: pNames,
        datasets: [{
        label: 'Karşılanan Talep',
        data: pCounts,
        backgroundColor: '#0f172a',
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 } },
        x: { grid: { display: false } }
        }
        }
        });
        });
    </script>
</body>
</html>